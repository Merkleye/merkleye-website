---
import Layout from "../../layouts/Layout.astro";
import LegalNav from "../../components/LegalNav.astro";
import Footer from "../../components/Footer.astro";
import DraftNotice from "../../components/DraftNotice.astro";

const policies = [
  {
    href: "/legal/terms/",
    name: "Terms of Service",
    body: "The terms for using this website and for downloading and running the freely-licensed editions of Merkleye.",
  },
  {
    href: "/legal/privacy/",
    name: "Privacy Policy",
    body: "What we collect, what we deliberately never receive, and why a self-hosted product changes that answer.",
  },
  {
    href: "/legal/license/",
    name: "Commercial License Agreement",
    body: "The paid licence: what a domain is for metering, term and renewal, trials, support, and the AGPL exception.",
  },
  {
    href: "/legal/dpa/",
    name: "Data Processing Addendum",
    body: "GDPR roles and obligations. In most deployments we are not a processor of your monitoring data at all.",
  },
  {
    href: "/legal/subprocessors/",
    name: "Subprocessors",
    body: "Every third party that touches data we hold, and what each of them is used for.",
  },
  {
    href: "/legal/acceptable-use/",
    name: "Acceptable Use Policy",
    body: "The narrow set of things you may not do with Merkleye or with what it finds.",
  },
  {
    href: "/legal/trademark/",
    name: "Trademark Policy",
    body: "How to refer to Merkleye, and what a fork has to change.",
  },
  {
    href: "/legal/security/",
    name: "Security & Vulnerability Disclosure",
    body: "How to report a vulnerability, our safe-harbour commitment, and response targets.",
  },
];
---

<Layout
  title="Legal — Merkleye"
  description="Merkleye's terms, privacy policy, commercial licence, data processing addendum, subprocessor list, acceptable use policy, trademark policy, and vulnerability disclosure process."
>
  <LegalNav />
  <main class="mx-auto max-w-3xl px-6 pt-14 pb-24">
    <p class="font-mono text-xs tracking-widest text-(--color-accent-dim) uppercase">
      Legal
    </p>
    <h1
      class="mt-3 text-3xl font-semibold tracking-tight text-balance text-(--color-ink) sm:text-4xl"
    >
      Policies
    </h1>
    <p class="mt-5 max-w-2xl leading-relaxed text-(--color-ink-muted)">
      Merkleye runs on your own infrastructure. That single fact shortens most
      of what follows: your domain list, your certificates, and your findings
      stay on your machines, so there is very little of yours for us to have a
      policy about.
    </p>

    <DraftNotice />

    <ul class="mt-10 grid gap-3">
      {
        policies.map((p) => (
          <li>
            <a
              href={p.href}
              class="group flex flex-col rounded-lg border border-(--color-border) bg-(--color-surface) p-5 transition-colors hover:border-(--color-accent-dim)"
            >
              <span class="font-mono text-sm font-semibold text-(--color-ink) group-hover:text-(--color-accent-dim)">
                {p.name}
              </span>
              <span class="mt-1.5 text-sm leading-relaxed text-(--color-ink-muted)">
                {p.body}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-12 text-sm text-(--color-ink-faint)">
      Machine-readable security contact:
      <a
        href="/.well-known/security.txt"
        class="text-(--color-accent-dim) hover:underline"
        >/.well-known/security.txt</a
      >.
    </p>
  </main>
  <Footer />
</Layout>
