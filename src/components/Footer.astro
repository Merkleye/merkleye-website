---
const year = new Date().getFullYear();
---

<footer class="border-t border-(--color-border-soft) py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 text-center sm:flex-row sm:justify-between sm:text-left"
  >
    <div class="flex items-center gap-2.5">
      <svg
        class="brand-logo-dark"
        height="34"
        viewBox="0 0 680 200"
        aria-label="Merkleye"
      >
        <g transform="translate(0,0)">
          <path
            d="M28,100 Q100,44 172,100 Q100,156 28,100 Z"
            fill="none"
            stroke="#35d0c0"
            stroke-width="7"
            stroke-linejoin="round"></path>
          <g stroke="#5c7078" stroke-width="2.6" fill="none">
            <line x1="81.6" y1="114.2" x2="90.8" y2="98.1"></line>
            <line x1="100" y1="114.2" x2="90.8" y2="98.1"></line>
            <line x1="90.8" y1="98.1" x2="104.6" y2="82"></line>
            <line x1="118.4" y1="114.2" x2="104.6" y2="82"></line>
          </g>
          <circle cx="104.6" cy="82" r="4.6" fill="#35d0c0"></circle>
          <circle cx="90.8" cy="98.1" r="3.7" fill="#1c8f85"></circle>
          <circle cx="81.6" cy="114.2" r="3.7" fill="#8fa1ab"></circle>
          <circle cx="100" cy="114.2" r="3.7" fill="#8fa1ab"></circle>
          <circle cx="118.4" cy="114.2" r="3.7" fill="#8fa1ab"></circle>
        </g>
        <text
          x="210"
          y="118"
          font-family="'Space Grotesk','Inter',Arial,sans-serif"
          font-size="72"
          font-weight="600"
          letter-spacing="-1"
          fill="#e7eef2">merkl<tspan fill="#35d0c0">e</tspan>ye</text>
        <text
          x="212"
          y="150"
          font-family="'Inter',Arial,sans-serif"
          font-size="18"
          font-weight="500"
          letter-spacing="3"
          fill="#8fa1ab">CERTIFICATE TRANSPARENCY</text>
      </svg>
      <svg
        class="brand-logo-light"
        height="34"
        viewBox="0 0 680 200"
        aria-label="Merkleye"
      >
        <g transform="translate(0,0)">
          <path
            d="M28,100 Q100,44 172,100 Q100,156 28,100 Z"
            fill="none"
            stroke="#0f9c8c"
            stroke-width="7"
            stroke-linejoin="round"></path>
          <g stroke="#55666e" stroke-width="2.6" fill="none">
            <line x1="81.6" y1="114.2" x2="90.8" y2="98.1"></line>
            <line x1="100" y1="114.2" x2="90.8" y2="98.1"></line>
            <line x1="90.8" y1="98.1" x2="104.6" y2="82"></line>
            <line x1="118.4" y1="114.2" x2="104.6" y2="82"></line>
          </g>
          <circle cx="104.6" cy="82" r="4.6" fill="#0f9c8c"></circle>
          <circle cx="90.8" cy="98.1" r="3.7" fill="#0a7568"></circle>
          <circle cx="81.6" cy="114.2" r="3.7" fill="#3f4f57"></circle>
          <circle cx="100" cy="114.2" r="3.7" fill="#3f4f57"></circle>
          <circle cx="118.4" cy="114.2" r="3.7" fill="#3f4f57"></circle>
        </g>
        <text
          x="210"
          y="118"
          font-family="'Space Grotesk','Inter',Arial,sans-serif"
          font-size="72"
          font-weight="600"
          letter-spacing="-1"
          fill="#0b1116">merkl<tspan fill="#0a7568">e</tspan>ye</text>
        <text
          x="212"
          y="150"
          font-family="'Inter',Arial,sans-serif"
          font-size="18"
          font-weight="500"
          letter-spacing="3"
          fill="#3f4f57">CERTIFICATE TRANSPARENCY</text>
      </svg>
      <span class="font-mono text-sm text-(--color-ink-muted)">
        · Apache-2.0 · {year}
      </span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-(--color-ink-faint)">
      <a href="https://github.com/wesleykirkland/merkleye" class="hover:text-(--color-ink)"
        >Core engine</a
      >
      <a href="https://github.com/wesleykirkland/merkleye-ui" class="hover:text-(--color-ink)"
        >Dashboard UI</a
      >
      <a
        href="https://github.com/wesleykirkland/merkleye/blob/main/LICENSE"
        class="hover:text-(--color-ink)">License</a
      >
      <a href="#top" class="hover:text-(--color-ink)">Back to top ↑</a>
    </div>
  </div>
</footer>
