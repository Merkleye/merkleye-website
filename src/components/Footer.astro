---
const year = new Date().getFullYear();
---

<footer class="border-t border-(--color-border-soft) py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 text-center sm:flex-row sm:justify-between sm:text-left"
  >
    <div class="flex items-center gap-2.5">
      <svg width="18" height="18" viewBox="0 0 32 32" fill="none" class="text-(--color-accent)" aria-hidden="true">
        <circle cx="16" cy="16" r="6.5" stroke="currentColor" stroke-width="2"></circle>
        <circle cx="16" cy="16" r="2" fill="currentColor"></circle>
      </svg>
      <span class="font-mono text-sm text-(--color-ink-muted)">
        merkleye · Apache-2.0 · {year}
      </span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-(--color-ink-faint)">
      <a href="https://github.com/wesleykirkland/merkleye" class="hover:text-(--color-ink)"
        >Core engine</a
      >
      <a href="https://github.com/wesleykirkland/merkleye-ui" class="hover:text-(--color-ink)"
        >Dashboard UI</a
      >
      <a href="/legal/terms/" class="hover:text-(--color-ink)">Terms</a>
      <a href="/legal/privacy/" class="hover:text-(--color-ink)">Privacy</a>
      <a href="/legal/security/" class="hover:text-(--color-ink)">Security</a>
      <a href="/legal/" class="hover:text-(--color-ink)">Legal</a>
      <a href="#top" class="hover:text-(--color-ink)">Back to top ↑</a>
    </div>
  </div>
</footer>
