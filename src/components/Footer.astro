---
const year = new Date().getFullYear();
---

<footer class="border-t border-(--color-border-soft) py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 text-center sm:flex-row sm:justify-between sm:text-left"
  >
    <div class="flex items-center gap-2.5">
      <img
        src="/logos/merkleye-logotype-dark-transparent-notagline.svg"
        alt="Merkleye"
        class="brand-logo-dark w-36 h-auto"
      />
      <img
        src="/logos/merkleye-logotype-light-transparent-notagline.svg"
        alt="Merkleye"
        class="brand-logo-light w-36 h-auto"
      />
      <span class="font-mono text-sm text-(--color-ink-muted)">
        · Apache-2.0 · {year}
      </span>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-(--color-ink-faint)">
      <a href="https://github.com/merkleye/merkleye" class="hover:text-(--color-ink)"
        >Core engine</a
      >
      <a href="https://github.com/merkleye/merkleye-ui" class="hover:text-(--color-ink)"
        >Dashboard UI</a
      >
      <a
        href="https://github.com/merkleye/merkleye/blob/main/LICENSE"
        class="hover:text-(--color-ink)">License</a
      >
      <a href="#top" class="hover:text-(--color-ink)">Back to top ↑</a>
    </div>
  </div>
</footer>
