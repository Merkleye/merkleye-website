---
const links = [
  { href: "#pillars", label: "Why Merkleye" },
  { href: "#architecture", label: "Architecture" },
  { href: "#correctness", label: "Correctness" },
  { href: "#self-hosting", label: "Self-hosting" },
  { href: "#ecosystem", label: "Ecosystem" },
];
---

<header
  class="sticky top-0 z-50 border-b border-(--color-border-soft) bg-(--color-bg)/85 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
    aria-label="Primary"
  >
    <a href="#top" class="flex items-center">
      <img
        src="/logos/merkleye-logotype-dark-transparent-notagline.svg"
        alt="Merkleye"
        class="brand-logo-dark w-36 h-auto"
      />
      <img
        src="/logos/merkleye-logotype-light-transparent-notagline.svg"
        alt="Merkleye"
        class="brand-logo-light w-36 h-auto"
      />
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-(--color-ink-muted) transition-colors hover:text-(--color-ink)"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/wesleykirkland/merkleye"
        class="hidden items-center gap-1.5 text-sm text-(--color-ink-muted) transition-colors hover:text-(--color-ink) sm:flex"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        <span>GitHub</span>
      </a>
      <a
        href="#self-hosting"
        class="rounded-md border border-(--color-accent-dim) bg-(--color-accent)/3 px-3.5 py-1.5 text-sm font-medium text-(--color-accent-dim) transition-colors hover:bg-(--color-accent)/3 hover:border-(--color-accent)"
      >
        Quick start
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-(--color-border) text-(--color-ink-muted) transition-colors hover:border-(--color-accent-dim) hover:text-(--color-ink)"
      >
        <svg
          class="icon-sun"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          class="icon-moon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  function currentTheme(): "light" | "dark" {
    return (
      (document.documentElement.getAttribute("data-theme") as
        | "light"
        | "dark"
        | null) ??
      (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark")
    );
  }

  const toggle = document.getElementById("theme-toggle");

  function updateLabel() {
    const isDark = currentTheme() === "dark";
    toggle?.setAttribute(
      "aria-label",
      isDark ? "Switch to light theme" : "Switch to dark theme",
    );
  }

  updateLabel();
  toggle?.addEventListener("click", () => {
    (window as any).__toggleTheme?.();
    updateLabel();
  });
  matchMedia("(prefers-color-scheme: light)").addEventListener(
    "change",
    updateLabel,
  );
</script>
