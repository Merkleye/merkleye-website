---
const stages = [
  {
    n: "01",
    title: "CT logs",
    detail: "Every RFC6962 and static-ct-api log, worldwide.",
  },
  {
    n: "02",
    title: "certspotter sidecar",
    detail: "SSLMate's certspotter tails each log continuously — no polling.",
  },
  {
    n: "03",
    title: "Normalize · dedup · match",
    detail:
      "A-label/punycode normalization, sha256(DER) dedup, PSL eTLD+1 reduction, hash-set match.",
  },
  {
    n: "04",
    title: "Policy & score",
    detail:
      "Expected-issuer substring check, transparent additive risk score.",
  },
  {
    n: "05",
    title: "Persist",
    detail: "Only matches land in Postgres — non-matches are discarded.",
  },
  {
    n: "06",
    title: "Notify",
    detail: "SMTP, webhook, Discord, Slack — deduplicated and rate-limited.",
  },
];
---

<section id="architecture" class="border-t border-(--color-border-soft) py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <p class="font-mono text-xs tracking-widest text-(--color-accent-dim) uppercase">
        Pipeline
      </p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-(--color-ink) sm:text-4xl">
        From log entry to Slack message, one straight line.
      </h2>
      <p class="mt-4 text-base leading-relaxed text-(--color-ink-muted)">
        No queue of domains to poll, no scheduled crawl. Every stage runs as
        certificates arrive on the log stream.
      </p>
    </div>

    <div class="mt-14 overflow-x-auto pb-4">
      <div class="flex min-w-[880px] items-stretch gap-3 md:min-w-0">
        {
          stages.map((s, i) => (
            <>
              <div class="flex w-full flex-1 flex-col rounded-xl border border-(--color-border) bg-(--color-surface) p-5">
                <span class="font-mono text-xs text-(--color-ink-faint)">{s.n}</span>
                <h3 class="mt-3 text-sm font-semibold text-(--color-ink)">{s.title}</h3>
                <p class="mt-2 text-[13px] leading-relaxed text-(--color-ink-muted)">
                  {s.detail}
                </p>
              </div>
              {i < stages.length - 1 && (
                <div class="flex shrink-0 items-center text-(--color-accent-dim)" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </div>
              )}
            </>
          ))
        }
      </div>
    </div>

    <div
      class="mt-8 flex flex-col gap-4 rounded-xl border border-(--color-border-soft) bg-(--color-surface)/60 p-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-(--color-ink-muted)">
        <span class="font-medium text-(--color-ink)">Observability included:</span>
        OpenTelemetry tracing over OTLP/gRPC across every stage, ready to feed
        a Grafana · Prometheus · Loki · Tempo stack for enterprise deployments —
        or ignore it entirely on a homelab box.
      </p>
      <a
        href="https://github.com/wesleykirkland/merkleye"
        class="shrink-0 text-sm font-medium text-(--color-accent-dim) hover:underline"
        >Read the internals →</a
      >
    </div>
  </div>
</section>
