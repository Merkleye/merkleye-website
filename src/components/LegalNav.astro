---
const links = [
  { href: "/legal/terms/", label: "Terms" },
  { href: "/legal/privacy/", label: "Privacy" },
  { href: "/legal/license/", label: "License" },
  { href: "/legal/security/", label: "Security" },
];

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-(--color-border-soft) bg-(--color-bg)/85 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4"
    aria-label="Legal"
  >
    <a href="/" class="flex items-center gap-2.5">
      <svg
        width="22"
        height="22"
        viewBox="0 0 32 32"
        fill="none"
        class="text-(--color-accent)"
        aria-hidden="true"
      >
        <circle cx="16" cy="16" r="6.5" stroke="currentColor" stroke-width="2"
        ></circle>
        <circle cx="16" cy="16" r="2" fill="currentColor"></circle>
        <path
          d="M6 16c2-5 6-8 10-8s8 3 10 8"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          opacity="0.55"></path>
        <path
          d="M6 16c2 5 6 8 10 8s8-3 10-8"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          opacity="0.55"></path>
      </svg>
      <span
        class="font-mono text-[15px] font-semibold tracking-tight text-(--color-ink)"
        >merkleye</span
      >
    </a>

    <ul class="hidden items-center gap-6 sm:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href ? "page" : undefined}
              class:list={[
                "text-sm transition-colors hover:text-(--color-ink)",
                path === link.href
                  ? "text-(--color-accent-dim)"
                  : "text-(--color-ink-muted)",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="theme-toggle"
      type="button"
      class="theme-toggle inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-(--color-border) text-(--color-ink-muted) transition-colors hover:border-(--color-accent-dim) hover:text-(--color-ink)"
    >
      <svg
        class="icon-sun"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        ></path>
      </svg>
      <svg
        class="icon-moon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
      </svg>
    </button>
  </nav>
</header>

<script>
  function currentTheme(): "light" | "dark" {
    return (
      (document.documentElement.getAttribute("data-theme") as
        | "light"
        | "dark"
        | null) ??
      (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark")
    );
  }

  const toggle = document.getElementById("theme-toggle");

  function updateLabel() {
    const isDark = currentTheme() === "dark";
    toggle?.setAttribute(
      "aria-label",
      isDark ? "Switch to light theme" : "Switch to dark theme",
    );
  }

  updateLabel();
  toggle?.addEventListener("click", () => {
    (window as any).__toggleTheme?.();
    updateLabel();
  });
  matchMedia("(prefers-color-scheme: light)").addEventListener(
    "change",
    updateLabel,
  );
</script>
