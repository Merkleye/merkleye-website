{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "GitHub Actions, non-major.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "bump"],
      "groupName": "Actions Minor"
    },
    {
      "description": "GitHub Actions, major -- reviewed separately since these can be breaking.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "Actions Major"
    },
    {
      "description": "mise-managed toolchain pins (mise.toml: go, terraform, golangci-lint, ruff, coverage, node), non-major.",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "bump"],
      "groupName": "Mise Minor"
    },
    {
      "description": "mise-managed toolchain pins, major -- reviewed separately since these can be breaking.",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major"],
      "groupName": "Mise Major"
    },
    {
      "description": "npm devDependencies (semantic-release and its plugins), non-major.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "bump"],
      "groupName": "NPM Minor"
    },
    {
      "description": "npm devDependencies, major -- reviewed separately since these can be breaking.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "NPM Major"
    }
  ]
}
